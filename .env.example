# ---- Telegram ----
# Токен від @BotFather. Старий формат "bot123456:AAA..." теж підтримується.
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Telegram ID адміністраторів (через кому): отримують сповіщення про збої, мають /stats,
# можуть керувати адресами в будь-якому чаті. Свій ID можна дізнатись у @userinfobot.
ADMIN_IDS=111111111
# Необов'язково: обмежити бота списком чатів/користувачів (через кому). Порожньо = бот відкритий.
ALLOWED_CHAT_IDS=
# Скільки адрес може мати один чат
MAX_ADDRESSES_PER_CHAT=5

# ---- Slack (необов'язково, лише для адрес з addresses.toml) ----
SLACK_TOKEN=

# ---- Опитування сайту ----
POLL_INTERVAL=900          # секунд між перевірками (мінімум 60)
REQUEST_TIMEOUT=15
RETRIES=3                  # спроб на один запит
RETRY_DELAY=5              # початкова пауза між спробами, далі подвоюється
CONCURRENCY=3              # скільки адрес опитувати одночасно

# ---- Типові налаштування нових адрес ----
DEFAULT_SILENT=true        # повідомлення без звуку
DEFAULT_GRAPHS=false       # слати картинку з графіком

# ---- Пошук вулиці за назвою (див. README, розділ "Пошук вулиці") ----
# URL запиту автодоповнення з DevTools; {query} буде замінено на введений текст.
HOE_STREET_SEARCH_URL=

# ---- Шифрування секретів у базі ----
# Ключ, яким шифруються токени Slack-ботів і паролі від особистого кабінету. Дуже рекомендовано.
# Без нього токени Slack лежать у базі відкритим текстом, а інтеграцію з кабінетом вимкнено.
# Згенерувати:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Не змінюй і не губи ключ: без нього збережене не розшифрується (користувачам доведеться
# заново підключити Slack-ботів і ввести паролі від кабінету).
SECRET_KEY=

# ---- Особистий кабінет cabinet.hoe.com.ua (потребує SECRET_KEY) ----
# Користувачі можуть дати боту логін/пароль від кабінету — тоді черга адреси береться звідти
# і оновлюється автоматично.
CABINET_ENABLED=true
CABINET_SYNC_INTERVAL=21600  # секунд між оновленнями черг із кабінету (мінімум 900)

# ---- Службове ----
DB_PATH=data/hoe.sqlite3
ADDRESSES_FILE=addresses.toml
LOG_LEVEL=INFO
